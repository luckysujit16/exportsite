# --- Site URL ---
APP_URL=http://localhost:3000

# --- Gmail SMTP ---
# Gmail requires an "App Password" (not your normal Gmail password), and
# only works if 2-Step Verification is enabled on the account:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already on)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create an app password (name it e.g. "SJFK Website") and copy the
#      16-character password Google gives you into EMAIL_PASS below.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-app-password

# --- Sender identity ---
# Gmail requires FROM_EMAIL to match (or be an alias of) EMAIL_USER above,
# or Gmail's SMTP server will silently rewrite/reject the From header.
FROM_EMAIL=your-gmail-address@gmail.com
EMAIL_NAME=SJFK Fintech

# Optional: address shown as "Reply-To" on the auto-reply confirmation sent
# to visitors. Defaults to FROM_EMAIL if unset.
REPLY_TO_EMAIL=info@sjfkfintech.com

# --- Where contact form submissions are delivered ---
# Defaults to FROM_EMAIL if unset.
CONTACT_TO_EMAIL=info@sjfkfintech.com
